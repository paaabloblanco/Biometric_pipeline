# Copia este archivo a .env y rellena los valores. El .env real no se sube (.gitignore).

# ==== Django ====
# Genera una nueva con: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# Entorno: dev (por defecto) o prod. Ver core/settings/.
DJANGO_ENV=dev
# Solo en prod (obligatorias): hosts permitidos y orígenes CORS del frontend, separados por comas.
DJANGO_ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=

# ==== Base de datos (Supabase / Postgres) ====
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# ==== Sync de Health Connect ====
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
HEALTH_CONNECT_DB=health_connect_export.db
HEALTH_CONNECT_ZIP=

# ==== Gemini ====
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ==== Bot de Telegram ====
# Token que da @BotFather al crear el bot.
TELEGRAM_BOT_TOKEN=
# chat_id autorizados, separados por comas. Averigua el tuyo con @userinfobot.
TELEGRAM_ALLOWED_CHAT_IDS=
# Instrucción por defecto para /analisis sin argumentos y para el push diario.
TELEGRAM_DEFAULT_INSTRUCTION=Dame el análisis de recuperación del día.
