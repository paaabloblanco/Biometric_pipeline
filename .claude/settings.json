{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "venv/Scripts/python.exe .claude/hooks/block_secrets.py",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "venv/Scripts/python.exe .claude/hooks/block_push_main.py",
            "if": "Bash(git push*)",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "venv/Scripts/python.exe .claude/hooks/format_python.py",
            "timeout": 45
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "venv/Scripts/python.exe .claude/hooks/quality_check.py",
            "timeout": 90,
            "statusMessage": "Chequeo de calidad (ruff)…"
          }
        ]
      }
    ]
  }
}
